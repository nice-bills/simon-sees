# Copy to .env and `set -a; source .env; set +a` before running. Everything is optional.
SIMON_MODEL=LiquidAI/d1-3B          # or LiquidAI/d1-omni-600M
SIMON_DEVICE=auto                   # auto | cuda | mps | cpu
SIMON_DTYPE=auto                    # auto | fp32 | bf16 | fp16
SIMON_TTS=auto                      # auto | kokoro | piper | browser
# SIMON_PIPER_VOICE=/path/to/en_US-lessac-medium.onnx
# SIMON_KOKORO_VOICE=am_michael
# SIMON_WHISPER=base.en
SIMON_LOG=logs/decisions.jsonl
# SIMON_SAVE_FRAMES=captures        # keep judged frames locally to label for bench/
# SENTRY_DSN=https://...            # turns on Sentry Agent Tracing
# SENTRY_SEND_PROMPTS=0             # 1 = attach question text + answers to spans (never images)
# SEGMENTER=auto                    # auto (SAM 3, else FALLBACK RT-DETR) | sam3 | sam3.1 | fallback | mock
# EMBEDDER=auto                     # auto (DINOv3, else FALLBACK DINOv2-small) | dinov3 | dinov2 | mock
# SAM3_IMAGE_SIZE=560               # SAM 3 input size on CPU (1008 = trained size, default on GPU)
# SIMON_VISION_URL=https://<you>--simon-sees-vision-web.modal.run   # run vision + d1 on Modal (docs/modal.md)
# SIMON_VISION_TOKEN=wk-xxx.ws-xxx  # Modal proxy token "<id>.<secret>"
# Playtests (docs/playtest.md)
# SIMON_RECORD=0                    # turn the session recorder off (on by default, writes sessions/)
# SIMON_SESSIONS=sessions           # where sessions are recorded
# SIMON_UPLOAD=hf                   # upload the session to your private HF dataset at the end of every game
# SIMON_HF_REPO=nice-bill/simon-sees-playtests   # the dataset repo (needs HF_TOKEN with write access)
